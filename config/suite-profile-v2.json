{
  "schema": "suite.profile.v2",
  "contract": "suite-foundation-v2",
  "contractRevision": "2.3.0",
  "application": "gaylemon",
  "displayName": "Gaylémon",
  "profile": "seasonal-go-microsite",
  "lifecycle": "active-season",
  "repository": "https://github.com/MathieuLF/gaylemon",
  "version": {
    "schema": "suite.version.v1",
    "source": "VERSION",
    "publicLabel": "Version X.Y.Z",
    "route": "/api/version",
    "evidence": ["internal/web/server.go"]
  },
  "capabilities": [
    "fr-ca",
    "accessibility",
    "command-palette",
    "safe-offline",
    "cache-safe-assets",
    "network-recovery-notice",
    "changelog",
    "information-page",
    "version-contract",
    "privacy-link",
    "season-lifecycle",
    "signed-agent",
    "signed-oci",
    "sbom-spdx",
    "sbom-cyclonedx",
    "gitleaks",
    "trivy-fs",
    "trivy",
    "release-receipts",
    "operations-contract"
  ],
  "dependencies": {
    "go": "1.27.0",
    "postgresql": "16",
    "pgx": "5.10.0",
    "river": "0.44.1"
  },
  "update": {
    "engine": "private-operations-authority",
    "source": "digest",
    "artifact": "ghcr.io/mathieulf/gaylemon",
    "backup": "private-operations-authority"
  },
  "validation": {
    "receiptSchema": "suite.local-validation.v2",
    "inventory": true,
    "quick": true,
    "full": true,
    "fullSecurity": {
      "policy": "config/full-security-policy-v1.json",
      "requiredChecks": ["gitleaks", "trivy-filesystem", "sbom-spdx", "sbom-cyclonedx"]
    }
  },
  "release": {
    "receiptSchema": "suite.release.v1",
    "requiresImmutableSource": true,
    "releasePredicate": "urn:gaylemon:attestation:release-manifest:v1"
  },
  "assets": {
    "schema": "suite.asset-manifest.v1",
    "manifestRoute": "/asset-manifest.json",
    "manifestSource": "internal/web/server.go",
    "contentHashedCssAndJavaScript": true,
    "immutableOnlyWhenHashed": true,
    "revalidated": ["html", "service-worker", "version", "asset-manifest"],
    "serviceWorkerRoute": "/sw.js",
    "serviceWorkerSource": "portal/sw.js",
    "exactServiceWorkerIdentity": true,
    "ignoreSearch": false,
    "retainedReleases": 2,
    "evidence": ["internal/web/server.go", "portal/sw.js", "internal/web/server_test.go"]
  },
  "exceptions": [
    "Une clôture de saison est une action opérateur distincte"
  ],
  "contractExceptions": []
}
