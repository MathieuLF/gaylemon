{
  "schema": "suite.profile.v2",
  "contract": "suite-foundation-v2",
  "contractRevision": "2.2.0",
  "application": "gaylemon",
  "displayName": "Gaylémon",
  "profile": "seasonal-go-microsite",
  "lifecycle": "active-season",
  "repository": "https://github.com/MathieuLF/gaylemon",
  "version": {"schema": "suite.version.v1", "source": "VERSION", "publicLabel": "Version X.Y.Z"},
  "capabilities": [
    "fr-ca",
    "accessibility",
    "command-palette",
    "safe-offline",
    "network-recovery-notice",
    "changelog",
    "information-page",
    "version-contract",
    "privacy-link",
    "season-lifecycle",
    "signed-agent",
    "signed-oci",
    "sbom-spdx",
    "sbom-cyclonedx",
    "gitleaks",
    "trivy-fs",
    "trivy",
    "release-receipts",
    "operations-contract"
  ],
  "dependencies": {
    "go": "1.27.0",
    "postgresql": "16",
    "pgx": "5.10.0",
    "river": "0.44.1"
  },
  "update": {
    "engine": "gaylemon-seasonal",
    "source": "digest",
    "artifact": "ghcr.io/mathieulf/gaylemon",
    "backup": "restic-offsite-postgresql-spool-and-palworld-final"
  },
  "validation": {
    "receiptSchema": "suite.local-validation.v2",
    "inventory": true,
    "quick": true,
    "full": true,
    "fullSecurity": {
      "policy": "config/full-security-policy-v1.json",
      "requiredChecks": ["gitleaks", "trivy-filesystem", "sbom-spdx", "sbom-cyclonedx"]
    }
  },
  "release": {
    "receiptSchema": "suite.release.v1",
    "requiresImmutableSource": true
  },
  "exceptions": [
    "Une clôture de saison est une action opérateur distincte"
  ]
}
