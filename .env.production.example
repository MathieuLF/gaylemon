# Ces quatre valeurs vivent dans le Vault DockPanel « Gaylémon production ».
# /etc/gaylemon/production.env est généré par gaylemon-vault-sync et ne se modifie pas directement.
GAYLEMON_DATABASE_URL=postgresql://gaylemon:MOT_DE_PASSE_APPLICATION@dockpanel-db-gaylemon:5432/gaylemon?sslmode=disable
GAYLEMON_AGENT_PUBLIC_KEYS=palworld-ubuntu:BASE64_CLE_PUBLIQUE_ED25519
GAYLEMON_GITHUB_CLIENT_ID=IDENTIFIANT_APPLICATION_GITHUB
GAYLEMON_GITHUB_CLIENT_SECRET=SECRET_APPLICATION_GITHUB
