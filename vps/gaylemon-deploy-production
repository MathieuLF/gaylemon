#!/usr/bin/env bash
set -euo pipefail

project_root="${GAYLEMON_PROJECT_ROOT:-/opt/gaylemon}"
compose_file="$project_root/compose.production.yaml"
production_env="/etc/gaylemon/production.env"
vault_sync="/usr/local/sbin/gaylemon-vault-sync"
cosign_key="${GAYLEMON_COSIGN_PUBLIC_KEY:-/etc/gaylemon/cosign.pub}"
image_reference="${GAYLEMON_IMAGE_REFERENCE:-}"
backup_receipt="${GAYLEMON_BACKUP_RECEIPT:-}"
receipt_root="/var/lib/gaylemon/deploy-receipts"
health_origin="${GAYLEMON_HEALTH_ORIGIN:-http://127.0.0.1:18081}"

if [[ "${EUID}" -ne 0 ]]; then
    echo "ERREUR: cette commande doit être exécutée par root." >&2
    exit 1
fi

[[ "$backup_receipt" == /* ]] || { echo "ERREUR: GAYLEMON_BACKUP_RECEIPT absolu requis." >&2; exit 1; }
for required_file in "$compose_file" "$project_root/VERSION" "$vault_sync" "$cosign_key" "$backup_receipt"; do
    if [[ ! -f "$required_file" ]]; then
        echo "ERREUR: fichier requis absent: $required_file" >&2
        exit 1
    fi
done

cosign_bin="$(command -v cosign || true)"
[[ -n "$cosign_bin" ]] || { echo "ERREUR: cosign est absent." >&2; exit 1; }

[[ "$image_reference" =~ ^ghcr\.io/mathieulf/gaylemon@sha256:[0-9a-f]{64}$ ]] || {
    echo "ERREUR: GAYLEMON_IMAGE_REFERENCE doit être un digest GHCR immuable." >&2
    exit 1
}
"$cosign_bin" verify --key "$cosign_key" "$image_reference" >/dev/null
"$cosign_bin" verify-attestation --key "$cosign_key" --type spdxjson "$image_reference" >/dev/null
"$cosign_bin" verify-attestation --key "$cosign_key" --type cyclonedx "$image_reference" >/dev/null
[[ "$(/usr/bin/stat -c '%U:%G:%a' "$backup_receipt")" == root:root:600 ]] || {
    echo "ERREUR: le reçu de sauvegarde doit appartenir à root:root en mode 0600." >&2
    exit 1
}

"$vault_sync" sync

release_version="$(/usr/bin/tr -d '\r\n' < "$project_root/VERSION")"
if [[ ! "$release_version" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[1-9][0-9]*$ ]]; then
    echo "ERREUR: VERSION doit respecter AAAA.MM.JJ.REVISION." >&2
    exit 1
fi
commit="$(/usr/bin/git -C "$project_root" rev-parse HEAD)"
compose=(/usr/bin/docker compose --project-directory "$project_root" --env-file "$production_env" -f "$compose_file")
previous_image="$(/usr/bin/docker inspect --format '{{.Config.Image}}' gaylemon-web-1 2>/dev/null || true)"
palworld_pid_before="$(/usr/bin/systemctl show palworld.service -p MainPID --value)"
palworld_restarts_before="$(/usr/bin/systemctl show palworld.service -p NRestarts --value)"
mutated=false

rollback() {
    local status="$1"
    trap - ERR
    if [[ "$mutated" == true && "$previous_image" =~ ^ghcr\.io/mathieulf/gaylemon@sha256:[0-9a-f]{64}$ ]]; then
        /usr/bin/env GAYLEMON_IMAGE_REFERENCE="$previous_image" "${compose[@]}" up -d --no-deps web || true
    fi
    exit "$status"
}
trap 'rollback $?' ERR

release_env=(GAYLEMON_IMAGE_REFERENCE="$image_reference")
/usr/bin/env "${release_env[@]}" "${compose[@]}" config --quiet
/usr/bin/docker pull "$image_reference"
mutated=true
/usr/bin/env "${release_env[@]}" "${compose[@]}" up -d --no-deps web

portal_ready=false
for _attempt in {1..30}; do
    if /usr/bin/curl --fail --silent --max-time 3 --output /dev/null "$health_origin/" 2>/dev/null; then
        portal_ready=true
        break
    fi
    /usr/bin/sleep 1
done

[[ "$portal_ready" == true ]] || { echo "ERREUR: le portail Gaylémon ne répond pas après le déploiement." >&2; false; }
for route in /informations /api/public/site-state/v1 /api/public/seasons/v1; do
    /usr/bin/curl --fail --silent --max-time 5 --output /dev/null "$health_origin$route"
done

readonly_root="$(/usr/bin/docker inspect --format '{{.HostConfig.ReadonlyRootfs}}' gaylemon-web-1)"
security_options="$(/usr/bin/docker inspect --format '{{json .HostConfig.SecurityOpt}}' gaylemon-web-1)"
container_status="$(/usr/bin/docker inspect --format '{{.State.Status}}' gaylemon-web-1)"
restart_count="$(/usr/bin/docker inspect --format '{{.RestartCount}}' gaylemon-web-1)"
[[ "$readonly_root" == true && "$security_options" == *no-new-privileges* && "$container_status" == running ]] || {
    echo "ERREUR: durcissement ou état du conteneur non conforme." >&2
    false
}
if /usr/bin/docker logs --since 5m gaylemon-web-1 2>&1 | /usr/bin/grep -Eiq 'panic:|fatal error:|migration.*(failed|error)'; then
    echo "ERREUR: les journaux récents contiennent une erreur bloquante." >&2
    false
fi

palworld_pid_after="$(/usr/bin/systemctl show palworld.service -p MainPID --value)"
palworld_restarts_after="$(/usr/bin/systemctl show palworld.service -p NRestarts --value)"
[[ "$palworld_pid_before" == "$palworld_pid_after" && "$palworld_restarts_before" == "$palworld_restarts_after" ]] || {
    echo "ERREUR: l'invariant palworld.service a été violé." >&2
    false
}
mutated=false
trap - ERR
/usr/bin/install -d -o root -g root -m 0700 "$receipt_root"
receipt="$receipt_root/$(/usr/bin/date -u +%Y%m%dT%H%M%SZ)-${commit:0:12}.json"
/usr/bin/printf '{"schema":"suite.production-update.v2","application":"gaylemon","commit":"%s","image":"%s","backupReceipt":"%s","healthOrigin":"%s","containerRestartCount":"%s","palworldPid":"%s","palworldRestarts":"%s","result":"success"}\n' \
    "$commit" "$image_reference" "$backup_receipt" "$health_origin" "$restart_count" "$palworld_pid_after" "$palworld_restarts_after" > "$receipt"
/usr/bin/chown root:root "$receipt"
/usr/bin/chmod 0600 "$receipt"

echo "Gaylémon $release_version (${commit:0:7}) déployé au digest vérifié; palworld.service est inchangé."
