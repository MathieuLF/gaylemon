# Configuration locale Gaylémon. Copier ce fichier vers .env.
# Ne jamais ajouter de mot de passe, jeton Cloudflare, clé API réelle ou secret SSH ici.

# Connexion au serveur Ubuntu
GAYLEMON_SSH_ALIAS=palworld
GAYLEMON_SSH_DIR=
GAYLEMON_SERVER_LAN_IP=192.168.1.50
GAYLEMON_REMOTE_PROJECT_ROOT=/home/gaylemon/Gaylemon
GAYLEMON_REMOTE_PROJECT_USER=gaylemon
GAYLEMON_REMOTE_STEAM_ROOT=/srv/storage/steam

# Microsite Docker local
GAYLEMON_MICROSITE_PORT=8787
GAYLEMON_MICROSITE_PUBLIC_URL=http://127.0.0.1:8787/
GAYLEMON_METRIC_INTERVAL_SECONDS=30
GAYLEMON_EVENT_SYNC_INTERVAL_SECONDS=60
GAYLEMON_EVENT_SYNC_TIMEOUT_SECONDS=60
GAYLEMON_SAVE_SNAPSHOT_SYNC_INTERVAL_SECONDS=300
GAYLEMON_SAVE_SNAPSHOT_SYNC_TIMEOUT_SECONDS=180
GAYLEMON_METRIC_UPDATE_TIMEOUT_SECONDS=120
GAYLEMON_DOCKER_MICROSITE_CONTAINER=gaylemon-microsite

# Tunnel REST Palworld local
GAYLEMON_API_TUNNEL_MODE=docker
GAYLEMON_API_LOCAL_PORT=8212
GAYLEMON_API_REMOTE_PORT=8212

# Disponibilité publique calculée depuis l'API REST Palworld
GAYLEMON_UPTIME_HISTORY_DAYS=90
GAYLEMON_RECOVERY_STALE_SECONDS=300
GAYLEMON_CLOUDFLARED_CONTAINER_PATTERN=cloudflared

# Accès public au jeu et communauté
GAYLEMON_GAME_HOST=palworld.example.com
GAYLEMON_GAME_PORT=8211
GAYLEMON_DISCORD_URL=https://discord.gg/EXEMPLE
GAYLEMON_GITHUB_URL=https://github.com/UTILISATEUR/gaylemon
GAYLEMON_GA4_ID=

# Dépendance PalworldSaveTools
GAYLEMON_SAVE_TOOLS_UPSTREAM=deafdudecomputers/PalworldSaveTools
GAYLEMON_SAVE_TOOLS_FORK=UTILISATEUR/PalworldSaveTools

# Tâches Windows
GAYLEMON_STARTUP_TASK_NAME=Gaylemon Ops Local Services
GAYLEMON_SAVE_TOOLS_TASK_NAME=Gaylemon PalworldSaveTools Maintenance

# Publication Go vers la VPS. La clé privée reste uniquement sur l'agent Ubuntu.
GAYLEMON_AGENT_ID=palworld-ubuntu
GAYLEMON_API_BASE_URL=https://gaylemon.nethercore.dev
GAYLEMON_AGENT_PRIVATE_KEY_FILE=
GAYLEMON_AGENT_SPOOL=
GAYLEMON_AGENT_HTTP_TIMEOUT=60s
GAYLEMON_AGENT_POLL_INTERVAL=15s

# Service web Go/PostgreSQL 16. Utiliser un fichier d'environnement privé sur la VPS.
GAYLEMON_DATABASE_URL=
GAYLEMON_AGENT_PUBLIC_KEYS=
GAYLEMON_PUBLIC_BASE_URL=https://gaylemon.nethercore.dev
GAYLEMON_LEGACY_HOSTS=gaylemon.mathieu.pro
GAYLEMON_GITHUB_CLIENT_ID=
GAYLEMON_GITHUB_CLIENT_SECRET=
GAYLEMON_GITHUB_ALLOWED_USER_ID=753560
