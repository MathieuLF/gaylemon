# Configuration locale fictive. Copier vers .env sans y placer de secret réel.

# Agent sortant signé
GAYLEMON_AGENT_ID=local-agent
GAYLEMON_API_BASE_URL=https://gaylemon.example
GAYLEMON_AGENT_PRIVATE_KEY_FILE=
GAYLEMON_RESPONSE_PUBLIC_KEY=
GAYLEMON_AGENT_SPOOL=runtime/agent-spool.db
GAYLEMON_AGENT_HTTP_TIMEOUT=60s
GAYLEMON_AGENT_POLL_INTERVAL=15s
GAYLEMON_AGENT_PROFILE=local
GAYLEMON_AGENT_SHADOW=true
GAYLEMON_COMMAND_HELPER=
GAYLEMON_COMMAND_SUDO=false

# Sources publiques déjà filtrées
GAYLEMON_STATS_PATH=runtime/input/stats.json
GAYLEMON_EVENTS_PATH=runtime/input/public-events.json
GAYLEMON_EVENTS_RECOVERY_PATH=runtime/input/events-recovery.json
GAYLEMON_RECENT_EVENTS_PATH=runtime/input/public-events-recent.json
GAYLEMON_SNAPSHOT_PATH=runtime/input/public-save-snapshot.json
GAYLEMON_BASES_PATH=runtime/input/public-save-bases.json
GAYLEMON_DIAGNOSTICS_PATH=runtime/input/public-save-diagnostics.json
GAYLEMON_CATALOG_MANIFEST_PATH=runtime/input/public-catalogs-manifest.json
GAYLEMON_CATALOGS_ROOT=runtime/input/public-catalogs
GAYLEMON_PALWORLD_API_HELPER=

# Service web local
GAYLEMON_WEB_LISTEN=127.0.0.1:8080
GAYLEMON_DATABASE_URL=postgresql://gaylemon:gaylemon@127.0.0.1:5432/gaylemon?sslmode=disable
GAYLEMON_PORTAL_ROOT=portal
GAYLEMON_ASSET_ROOT=runtime/public-assets
GAYLEMON_PUBLIC_BASE_URL=https://gaylemon.example
GAYLEMON_LEGACY_HOSTS=
GAYLEMON_AGENT_PUBLIC_KEYS=
GAYLEMON_RESPONSE_PRIVATE_KEY=
GAYLEMON_GITHUB_CLIENT_ID=
GAYLEMON_GITHUB_CLIENT_SECRET=
GAYLEMON_GITHUB_ALLOWED_USER_ID=
