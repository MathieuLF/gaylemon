[Unit]
Description=Build a privacy-filtered Palworld save snapshot
After=local-fs.target
OnSuccess=palworld-events.service

[Service]
Type=oneshot
User=gaylemon
Group=gaylemon
Nice=19
IOSchedulingClass=idle
CPUQuota=10%
CPUWeight=10
IOWeight=10
MemoryMax=2G
MemorySwapMax=0
TimeoutStartSec=900
UMask=0077
ExecStart=/usr/bin/flock --exclusive --timeout 420 /home/gaylemon/Gaylemon/runtime/collector-heavy.lock /home/gaylemon/Gaylemon/vendor/PalworldSaveTools-current/.venv/bin/python /home/gaylemon/Gaylemon/server/bin/palworld-save-snapshot.py --attempts 2 --retry-delay 150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/srv/storage/steam/servers/palworld/game/Pal/Saved/SaveGames /home/gaylemon/Gaylemon/vendor
ReadWritePaths=/home/gaylemon/Gaylemon/runtime
