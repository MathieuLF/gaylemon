[Unit]
Description=Build a privacy-filtered Palworld save snapshot
After=local-fs.target
OnSuccess=palworld-events.service

[Service]
Type=oneshot
User=gaylemon
Group=gaylemon
Nice=19
IOSchedulingClass=idle
CPUQuota=10%
CPUWeight=10
IOWeight=10
MemoryMax=2G
MemorySwapMax=0
TimeoutStartSec=180
UMask=0077
ExecStart=/srv/example/game-project/vendor/PalworldSaveTools-current/.venv/bin/python /srv/example/game-project/server/bin/palworld-save-snapshot.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/srv/storage/steam/servers/palworld/game/Pal/Saved/SaveGames /srv/example/game-project/vendor
ReadWritePaths=/srv/example/game-project/runtime
