[Unit]
Description=Project privacy-safe Palworld statistics in Go
After=palworld-stats.service

[Service]
Type=oneshot
User=gaylemon
Group=gaylemon
EnvironmentFile=/home/gaylemon/.config/gaylemon/agent.env
Environment=GAYLEMON_AGENT_PRIVATE_KEY_FILE=/run/credentials/gaylemon-collect-stats.service/agent.key
LoadCredential=agent.key:/home/gaylemon/.config/gaylemon/agent.key
ExecStart=/usr/local/bin/gaylemon collect --kind stats
Nice=15
CPUQuota=5%
CPUWeight=10
IOWeight=10
MemoryMax=128M
MemorySwapMax=0
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/gaylemon-agent
