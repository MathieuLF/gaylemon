[Unit]
Description=Queue privacy-safe Palworld snapshot for publication
After=palworld-save-snapshot.service

[Service]
Type=oneshot
User=gaylemon
Group=gaylemon
EnvironmentFile=/home/gaylemon/.config/gaylemon/agent.env
Environment=GAYLEMON_AGENT_PRIVATE_KEY_FILE=/run/credentials/gaylemon-publish-snapshot.service/agent.key
Environment=GOMEMLIMIT=640MiB
LoadCredential=agent.key:/home/gaylemon/.config/gaylemon/agent.key
ExecStart=/usr/local/bin/gaylemon collect --kind snapshot
Nice=19
IOSchedulingClass=idle
CPUQuota=10%
CPUWeight=10
IOWeight=10
MemoryMax=768M
MemorySwapMax=0
TimeoutStartSec=300
StateDirectory=gaylemon-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/gaylemon/Gaylemon/runtime
ReadWritePaths=/var/lib/gaylemon-agent
