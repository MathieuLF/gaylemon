[Unit]
Description=Queue privacy-safe Palworld events for publication
After=palworld-events.service

[Service]
Type=oneshot
User=gaylemon
Group=gaylemon
EnvironmentFile=/etc/example/game-agent/agent.env
Environment=GAYLEMON_AGENT_PRIVATE_KEY_FILE=/run/credentials/gaylemon-publish-events.service/agent.key
LoadCredential=agent.key:/etc/example/game-agent/agent.key
ExecStart=/usr/local/bin/gaylemon collect --kind events
Nice=19
CPUQuota=10%
MemoryMax=768M
StateDirectory=gaylemon-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/srv/example/game-project/runtime
ReadWritePaths=/var/lib/gaylemon-agent
