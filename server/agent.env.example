GAYLEMON_AGENT_ID=palworld-ubuntu
GAYLEMON_API_BASE_URL=https://gaylemon.nethercore.dev
GAYLEMON_RESPONSE_PUBLIC_KEY=BASE64_CLE_PUBLIQUE_ED25519_DU_SERVICE
GAYLEMON_AGENT_SPOOL=/var/lib/gaylemon-agent/spool.db
GAYLEMON_AGENT_HTTP_TIMEOUT=60s
GAYLEMON_AGENT_POLL_INTERVAL=15s
GAYLEMON_AGENT_PROFILE=jeu-prioritaire
GAYLEMON_AGENT_SHADOW=true
GAYLEMON_COMMAND_HELPER=/usr/local/sbin/gaylemon-admin
GAYLEMON_COMMAND_SUDO=true
GAYLEMON_STATS_PATH=/srv/storage/steam/servers/palworld/stats/stats.json
GAYLEMON_STATS_SUDO=true
GAYLEMON_PALWORLD_API_HELPER=/srv/storage/steam/bin/palworld-api.sh
GAYLEMON_PALWORLD_API_SUDO=true
GAYLEMON_EVENTS_PATH=/home/gaylemon/Gaylemon/runtime/public-events.json
GAYLEMON_RECENT_EVENTS_PATH=/home/gaylemon/Gaylemon/runtime/public-events-recent.json
