{
  "name": "gaylemon-validation",
  "private": true,
  "scripts": {
    "test": "npm run test:contracts",
    "test:contracts": "node --test portal/tests/*.test.mjs",
    "test:browser": "playwright test",
    "dev": "node portal/tests/browser/serve.mjs",
    "build": "node scripts/build-portal.mjs",
    "build:check": "node scripts/build-portal.mjs --check",
    "predev": "npm run build",
    "pretest:browser": "npm run build:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.2"
  },
  "type": "module"
}
